# Šablona konfigurace – zkopírujte do .env (soubor .env se neverzuje).
# Docker Compose z .env doplní proměnné; ./mvnw spring-boot:run jej načte také.

# Autentizace (JWT HS256) – SECRET_KEY musí mít alespoň 32 znaků
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Databáze PostgreSQL
# Při lokálním běhu mimo Docker je host "localhost"; docker-compose pro aplikaci nastavuje host "db" sám.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horyavoda
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seed syntetických dat (výchozí účty admin / recepce vzniknou jen se zadaným heslem)
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_PASSWORD=recepce123
# Ukázkový provoz: další kusy, zákazníci, výpůjčky a rezervace (syntetická data)
SEED_DEMO_DATA=true
